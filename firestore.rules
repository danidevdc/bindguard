
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read/write access on all documents to any user signed in to the application
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow any user to read their own user data
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      // Allow users to create their own user document
      allow create: if request.auth != null;
      // Allow only admins to read all user data
      allow list, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Allow any authenticated user to manage medicines
    // In a production app, this should be restricted to admins
    match /medicines/{medicineId} {
      allow read, write: if request.auth != null;
    }
  }
}
