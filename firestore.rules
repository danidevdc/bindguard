rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // Admins can read all user profiles
      function isUserAdmin() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      allow list: if request.auth != null && isUserAdmin();
    }

    match /medicines/{medicineId} {
      allow read: if request.auth != null;
      
      // Any authenticated user can update a medicine document (for dispensing/stocking)
      allow update: if request.auth != null;
      
      // Only admins can create or delete medicine records entirely
      allow create, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
